#!/bin/sh
# Start the vendor telnetd with its normal /bin/login, on the dashcam AP only.
[ -e /usr/bin/70mai-telnet.disabled ] && exit 0
pidfile=/var/run/70mai-telnet.pid
lock=/var/run/70mai-telnet.lock
service_pid=$(cat "$pidfile" 2>/dev/null)
case "$service_pid" in
    ''|*[!0-9]*) ;;
    *)
        if kill -0 "$service_pid" 2>/dev/null &&
           tr '\000' ' ' <"/proc/$service_pid/cmdline" 2>/dev/null | grep -q 'telnetd.*192.168.0.1'; then
            exit 0
        fi
        ;;
esac
mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock" 2>/dev/null' 0
attempt=0
while [ "$attempt" -lt 60 ]; do
    [ -e /usr/bin/70mai-telnet.disabled ] && exit 0
    if /sbin/ifconfig wlan0 2>/dev/null | grep -q 'inet addr:192.168.0.1 '; then
        /usr/sbin/telnetd -F -b 192.168.0.1 -p 23 </dev/null >>/var/run/70mai-telnet.log 2>&1 &
        service_pid=$!
        printf '%s\n' "$service_pid" >"$pidfile"
        sleep 0.2
        if kill -0 "$service_pid" 2>/dev/null; then
            echo "Telnet started on 192.168.0.1:23 (pid $service_pid)"
            exit 0
        fi
        echo 'Telnet failed to start; check the log above'
        exit 1
    fi
    attempt=$((attempt + 1))
    sleep 1
done
echo 'Telnet skipped: AP address did not appear within 60 seconds'
exit 0
